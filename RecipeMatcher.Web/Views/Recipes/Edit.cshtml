@model EditRecipeViewModel

<form asp-action="Edit" asp-route-recipeId="@Model.Id" method="POST">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All"></div>

    <label asp-for="Name"></label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <label asp-for="PreparationMinutes"></label>
    <input asp-for="PreparationMinutes" />
    <span asp-validation-for="PreparationMinutes"></span>


    <h3>Ingredients</h3>
    <ul>
        @for (var i = 0; i < Model.Ingredients.Count; i++)
        {
            <li>
                <input type="hidden" asp-for="Ingredients[i].Id" />

                <input type="hidden" asp-for="Ingredients[i].Name" />

                <input asp-for="Ingredients[i].Selected" />

                <label asp-for="Ingredients[i].Selected">
                    @Model.Ingredients[i].Name
                </label>
            </li>
        }
    </ul>

    <button type="submit">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}