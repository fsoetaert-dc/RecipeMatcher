@model EditRecipeViewModel

<form asp-action="Edit" asp-route-Id="@Model.Id" method="POST">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All"></div>

    <label asp-for="Name"></label>
    <input type= "text" asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <label asp-for="PreparationMinutes"></label>
    <input type="number" asp-for="PreparationMinutes" />
    <span asp-validation-for="PreparationMinutes"></span>


    <h3>Ingredients</h3>
    <ul>
        @foreach (var ingredient in Model.Ingredients)
        {
            <li>

                <input type="checkbox" asp-for="@ingredient.Selected" />

                <label asp-for="@ingredient.Selected">
                    @ingredient.Name 
                </label>
            </li>
        }
    </ul>

    <button type="submit">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}