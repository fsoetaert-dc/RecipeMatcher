@model IReadOnlyList<Recipe>

@{
    ViewData["Title"] = "Recipes";
}

<div class="text-center">
    <h1>Recipes</h1>
    <a asp-controller="Recipes" asp-action="Create">
        Add a recipe
    </a>
    <ul>
        @foreach (var recipe in Model)
        {
            <li>@recipe.Name, @recipe.PreparationMinutes minutes
                <a asp-action="Details" asp-route-id="@recipe.Id">Details</a>
                <a asp-action="Edit" asp-route-id="@recipe.Id">Edit</a>
                <a asp-action="DeletePage" asp-route-id="@recipe.Id">Delete</a>
            </li>
        }
    </ul>
</div>
