@model IReadOnlyList<Ingredient>

@{
    ViewData["Title"] = "Ingredients";
}

<div class="text-center">
    <h1>Ingredients</h1>

    <ul>
        @foreach (var ingredient in Model)
        {
            <li>@ingredient.Name
                <a asp-action="Edit" asp-route-id="@ingredient.Id">Edit</a>
                <a asp-action="DeletePage" asp-route-id="@ingredient.Id">Delete</a>
            </li>
        }
    </ul>
</div>
