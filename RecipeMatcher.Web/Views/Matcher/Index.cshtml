@model List<SelectIngredientViewModel>
Matcher<h3>Choose your available Ingredients</h3>
<form asp-controller="Matcher" asp-action="Results" method="post">
    <ul>
        @foreach (var ingredient in @Model)
        {
            <li>
                <input type="checkbox" 
                name="ingredientIds" 
                value="@ingredient.Id" 
                checked="@ingredient.Selected" />

                <label>
                    @ingredient.Name
                </label>
            </li>
        }
    </ul>
    <button type="submit">Search</button>
</form>

